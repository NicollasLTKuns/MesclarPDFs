
QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: "Segoe UI";
    font-size: 14px;
}

QPushButton {
    background-color: #45475a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 16px 16px;
}

QPushButton:hover {
    background-color: #585b70;
}

QPushButton:pressed {
    background-color: #313244;
}

QListWidget {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 5px;
}

QListWidget::item {
    border-radius: 6px;
    padding: 5px;
}

QListWidget::item:selected {
    background-color: #313244;
}

QLabel {
    background-color: transparent;
}

QToolButton {
    background-color: #45475a;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    padding: 3px 9px;
}

QToolButton:hover {
    background-color: #6c7086;
}
